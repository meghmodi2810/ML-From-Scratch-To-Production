# docker/Dockerfile.lambda
# =====================================================================
# AWS Lambda Serverless Container Image for NYC Taxi ML Inference
# =====================================================================
FROM public.ecr.aws/lambda/python:3.11

# Install build dependencies for C-extensions
RUN microdnf update -y && \
    microdnf install -y gcc gcc-c++ make && \
    microdnf clean all

# Install Python ML dependencies
COPY requirements-serve.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-serve.txt

# Copy application source code into Lambda task root
COPY src/ ${LAMBDA_TASK_ROOT}/src/

# Set the Lambda handler function entrypoint
CMD [ "src.serving.lambda_handler.handler" ]
