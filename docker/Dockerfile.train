# =====================================================================
# STAGE 1: BUILDER (Compilation & Dependency Installation)
# =====================================================================
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /install

# Install build dependencies for compiling C/C++ extensions & database drivers
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy dependency list first to leverage Docker layer caching
COPY requirements.txt .

# Install dependencies into virtualenv without pip cache
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# =====================================================================
# STAGE 2: RUNTIME (Slim Minimal Production Image)
# =====================================================================
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app"

WORKDIR /app

# Install only shared runtime libraries (no compilers/headers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy strictly the pre-compiled virtual environment from builder stage
COPY --from=builder /opt/venv /opt/venv

# Security: Create and switch to non-root application user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Copy application source code
COPY --chown=appuser:appuser src/ /app/src/

# Default entrypoint runs training verification
ENTRYPOINT ["python"]
CMD ["src/models/train_mlflow.py"]